{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CDDA Player control registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "standards",
    "controls"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "standards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "principles",
          "controls"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S-[A-Z]+$"
          },
          "principles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^P-[A-Z]+$"
            }
          },
          "controls": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^C-[A-Z]+$"
            }
          }
        }
      }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/control"
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "mode",
        "scope",
        "mechanism",
        "owner",
        "trigger",
        "evidence",
        "failure_response",
        "limitations",
        "enforcement"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^C-[A-Z]+$"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "mode": {
          "enum": [
            "automatic",
            "runtime",
            "manual"
          ]
        },
        "scope": {
          "$ref": "#/$defs/text"
        },
        "mechanism": {
          "$ref": "#/$defs/text"
        },
        "owner": {
          "$ref": "#/$defs/text"
        },
        "trigger": {
          "$ref": "#/$defs/text"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "failure_response": {
          "$ref": "#/$defs/text"
        },
        "limitations": {
          "$ref": "#/$defs/text"
        },
        "enforcement": {
          "$ref": "#/$defs/text"
        }
      }
    }
  }
}
