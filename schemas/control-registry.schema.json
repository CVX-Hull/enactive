{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CDDA Player control registry v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "standards",
    "controls"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "standards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "principles",
          "controls"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S-[A-Z]+$"
          },
          "principles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^P-[A-Z]+$"
            }
          },
          "controls": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^C-[A-Z]+$"
            }
          }
        }
      }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/control"
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "mode",
        "scope",
        "mechanism",
        "owner",
        "trigger",
        "evidence",
        "failure_response",
        "limitations",
        "enforcement",
        "status",
        "rationale",
        "replacement",
        "last_exercise",
        "maintenance_review",
        "next_review"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^C-[A-Z]+$"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "mode": {
          "enum": [
            "automatic",
            "runtime",
            "manual"
          ]
        },
        "scope": {
          "$ref": "#/$defs/text"
        },
        "mechanism": {
          "$ref": "#/$defs/text"
        },
        "owner": {
          "$ref": "#/$defs/text"
        },
        "trigger": {
          "$ref": "#/$defs/text"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "failure_response": {
          "$ref": "#/$defs/text"
        },
        "limitations": {
          "$ref": "#/$defs/text"
        },
        "enforcement": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "enum": [
            "proposed",
            "active",
            "deprecated",
            "retired"
          ]
        },
        "rationale": {
          "anyOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "type": "null"
            }
          ]
        },
        "replacement": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^C-[A-Z]+$"
        },
        "last_exercise": {
          "$ref": "#/$defs/exercise"
        },
        "maintenance_review": {
          "$ref": "#/$defs/review"
        },
        "next_review": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "exercise": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "date",
        "outcome",
        "scope",
        "evidence"
      ],
      "properties": {
        "date": {
          "$ref": "#/$defs/date"
        },
        "outcome": {
          "$ref": "#/$defs/text"
        },
        "scope": {
          "$ref": "#/$defs/text"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "review": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "date",
        "evidence",
        "effectiveness",
        "findings",
        "cost",
        "follow_up"
      ],
      "properties": {
        "date": {
          "$ref": "#/$defs/date"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "effectiveness": {
          "enum": [
            "effective",
            "partially_effective",
            "ineffective",
            "unassessed"
          ]
        },
        "findings": {
          "$ref": "#/$defs/text"
        },
        "cost": {
          "$ref": "#/$defs/text"
        },
        "follow_up": {
          "$ref": "#/$defs/text"
        }
      }
    }
  }
}
