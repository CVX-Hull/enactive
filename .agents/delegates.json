{
  "schema": "delegates/4",
  "role_instruction": "You are the {role}. Before starting, read and follow `.agents/roles/{role}.md`; that file owns the role. If it cannot be read, stop and report it.",
  "drop_environment": [
    "OPENROUTER_API_KEY",
    "OPENAI_API_KEY",
    "ANTHROPIC_API_KEY",
    "ANTHROPIC_AUTH_TOKEN",
    "GEMINI_API_KEY",
    "GOOGLE_API_KEY"
  ],
  "coding_agents": {
    "codex": {
      "name": "Codex",
      "version": ["codex", "--version"],
      "refusals": ["usage limit", "rate limit", "quota", "not logged in", "log ?in", "sign ?in", "unauthorized", "\\b401\\b", "\\b429\\b"],
      "usage": {
        "read": "stdout_jsonl",
        "where": {"type": "turn.completed"},
        "tokens": {
          "input_tokens": "usage.input_tokens",
          "cached_input_tokens": "usage.cached_input_tokens",
          "cache_write_input_tokens": "usage.cache_write_input_tokens",
          "output_tokens": "usage.output_tokens"
        }
      },
      "roles": {
        "worker": {
          "argv": ["codex", "exec", "--dangerously-bypass-approvals-and-sandbox", "-m", "{model}", "-c", "model_reasoning_effort={effort}", "-C", "{worktree}", "--json", "-o", "{reply_file}", "-"],
          "read_only": false,
          "brief": "stdin",
          "reply": "file"
        },
        "reviewer": {
          "argv": ["codex", "exec", "--dangerously-bypass-approvals-and-sandbox", "--ephemeral", "-m", "{model}", "-c", "model_reasoning_effort={effort}", "-C", "{worktree}", "--json", "-o", "{reply_file}", "-"],
          "read_only": true,
          "brief": "stdin",
          "reply": "file"
        },
        "explorer": {
          "argv": ["codex", "exec", "--dangerously-bypass-approvals-and-sandbox", "--ephemeral", "-m", "{model}", "-c", "model_reasoning_effort={effort}", "-C", "{worktree}", "--json", "-o", "{reply_file}", "-"],
          "read_only": true,
          "brief": "stdin",
          "reply": "file"
        },
        "locator": {
          "argv": ["codex", "exec", "--dangerously-bypass-approvals-and-sandbox", "--ephemeral", "-m", "{model}", "-c", "model_reasoning_effort={effort}", "-C", "{worktree}", "--json", "-o", "{reply_file}", "-"],
          "read_only": true,
          "brief": "stdin",
          "reply": "file"
        }
      }
    },
    "claude-code": {
      "name": "Claude Code",
      "version": ["claude", "--version"],
      "outcome_checks": {
        "error_flag": "is_error",
        "ok_status": {"path": "subtype", "values": ["success"]},
        "timeout_fields": ["subtype", "stop_reason"],
        "timeout_patterns": ["error_max_turns", "max_turns", "timed_?out", "timeout"]
      },
      "refusals": ["usage limit", "rate limit", "quota", "not logged in", "/login", "log ?in", "sign ?in", "unauthorized", "\\b401\\b", "\\b429\\b"],
      "usage": {
        "read": "stdout_json",
        "tokens": {
          "input_tokens": "usage.input_tokens",
          "cached_input_tokens": "usage.cache_read_input_tokens",
          "cache_write_input_tokens": "usage.cache_creation_input_tokens",
          "output_tokens": "usage.output_tokens"
        },
        "models": "modelUsage"
      },
      "roles": {
        "worker": {
          "argv": ["claude", "-p", "--model", "{model}", "--effort", "{effort}", "--permission-mode", "auto", "--settings", "{\"outputStyle\": \"default\"}", "--no-session-persistence", "--output-format", "json"],
          "read_only": false,
          "brief": "stdin",
          "reply": {"stdout_json": "result"}
        },
        "reviewer": {
          "argv": ["claude", "-p", "--model", "{model}", "--effort", "{effort}", "--permission-mode", "auto", "--settings", "{\"outputStyle\": \"default\"}", "--no-session-persistence", "--output-format", "json"],
          "read_only": true,
          "brief": "stdin",
          "reply": {"stdout_json": "result"}
        },
        "explorer": {
          "argv": ["claude", "-p", "--model", "{model}", "--effort", "{effort}", "--permission-mode", "auto", "--settings", "{\"outputStyle\": \"default\"}", "--no-session-persistence", "--output-format", "json"],
          "read_only": true,
          "brief": "stdin",
          "reply": {"stdout_json": "result"}
        },
        "locator": {
          "argv": ["claude", "-p", "--model", "{model}", "--effort", "{effort}", "--permission-mode", "auto", "--settings", "{\"outputStyle\": \"default\"}", "--no-session-persistence", "--output-format", "json"],
          "read_only": true,
          "brief": "stdin",
          "reply": {"stdout_json": "result"}
        }
      }
    },
    "antigravity": {
      "name": "Antigravity",
      "version": ["agy", "--version"],
      "outcome_checks": {
        "error_flag": "is_error",
        "ok_status": {"path": "status", "values": ["SUCCESS"]},
        "timeout_fields": ["finish_reason", "finishReason", "subtype"],
        "timeout_patterns": ["print_timeout", "max_turns", "timed_?out", "timeout"]
      },
      "refusals": ["usage limit", "rate limit", "quota", "not logged in", "log ?in", "sign ?in", "unauthorized", "\\b401\\b", "\\b429\\b"],
      "usage": {
        "read": "stdout_json",
        "tokens": {
          "input_tokens": "usage.input_tokens",
          "cached_input_tokens": "usage.cache_read_tokens",
          "output_tokens": "usage.output_tokens"
        }
      },
      "roles": {
        "worker": {
          "argv": ["agy", "--model", "{model}", "--effort", "{effort}", "--mode", "auto", "--output-format", "json", "-p", "{brief}"],
          "read_only": false,
          "brief": "argument",
          "reply": {"stdout_json": "response"}
        },
        "reviewer": {
          "argv": ["agy", "--model", "{model}", "--effort", "{effort}", "--mode", "auto", "--output-format", "json", "-p", "{brief}"],
          "read_only": true,
          "brief": "argument",
          "reply": {"stdout_json": "response"}
        },
        "explorer": {
          "argv": ["agy", "--model", "{model}", "--effort", "{effort}", "--mode", "auto", "--output-format", "json", "-p", "{brief}"],
          "read_only": true,
          "brief": "argument",
          "reply": {"stdout_json": "response"}
        },
        "locator": {
          "argv": ["agy", "--model", "{model}", "--effort", "{effort}", "--mode", "auto", "--output-format", "json", "-p", "{brief}"],
          "read_only": true,
          "brief": "argument",
          "reply": {"stdout_json": "response"}
        }
      }
    }
  }
}
