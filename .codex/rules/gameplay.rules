# Owner: lead. Review on CLI, permission or authority changes.
# Trusted inspected source only; source remains frozen during gameplay.
# Prefix allowances are host permission, not custody, filesystem confinement,
# provider spending authority, package admission or proof of active rule loading.
prefix_rule(
    pattern = [".venv/bin/python", "-m", "harness", ["status", "pause", "run"]],
    decision = "allow",
    justification = "Current local status/independent Pause or explicitly frozen finite player-host campaign under standing gameplay authorization.",
    match = [
        ".venv/bin/python -m harness status",
        ".venv/bin/python -m harness pause --url http://127.0.0.1:8766",
        ".venv/bin/python -m harness run --run .runtime/computer-sessions/selected",
    ],
    not_match = [
        ".venv/bin/python -c print(1)",
        ".venv/bin/python tools/setup.py --install",
        ".venv/bin/python -m harness serve --port 8766",
        ".venv/bin/python -m harness mission-request --request old.json",
        ".venv/bin/python -m harness key ESC",
        ".venv/bin/python -m harness resume",
        "python -m harness status",
        "gh pr merge 1",
    ],
)
